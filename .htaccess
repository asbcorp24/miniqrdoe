Options -Indexes
RewriteEngine On

# Keep private project files and the SQLite database inaccessible over HTTP.
RewriteRule ^(?:src|var|tools)(?:/|$) - [F,END,NC]
RewriteRule ^(?:\.git(?:/|$)|\.gitignore$|README\.md$) - [F,END,NC]

# These rules work both at the domain root and under a prefix such as /qrq/.
# END stops mod_rewrite from processing the internally rewritten /public/ URI
# again (REQUEST_URI is not reliable as a guard for subdirectory installs).
RewriteRule ^public/ - [END]
RewriteRule ^$ public/index.php [END]
RewriteRule ^(.+)$ public/$1 [END]
